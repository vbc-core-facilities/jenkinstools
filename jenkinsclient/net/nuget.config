<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--remove any preconfigured repos, use only what's defined here-->
    <clear/>
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!--the private feed JenkinsTools.Client is pushed to (Packaging.props). MUST use underscore, NOT dash (env var injection on unix)-->
    <add key="github_vbc_proteomics" value="https://nuget.pkg.github.com/vbc-proteomics-org/index.json" />
  </packageSources>
  <!--
    Restore takes everything from nuget.org; the private feed is only a push target. It needs credentials even to read,
    so without this mapping a restore in this public repo would fail for anyone without the feed's token.
  -->
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
