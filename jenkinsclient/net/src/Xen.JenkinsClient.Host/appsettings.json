{
  // No sites ship with the tool: it knows no organisation. Sites come from the user settings file
  // (%LOCALAPPDATA%/JenkinsClient/settings.json, or the path in JENKINSCLIENT_SETTINGS), environment variables
  // (JenkinsClient__Sites__<site>__BaseUrl, ...) and the command line, in that order of precedence (last wins).
  // An organisation preset is such a settings file (VBC: vbc_deployment JenkinsClientVbc/settings.json).
  "JenkinsClient": {
    "DefaultSite": "",
    "Sites": {}
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Xen.JenkinsClient": "Information"
    }
  }
}
