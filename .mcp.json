        "TESTSERVER_URL": "${TESTSERVER_URL:-http://127.0.0.1:18090}",
        "TESTSERVER_COMPOSE_DIR": "${TESTSERVER_COMPOSE_DIR:-../vbc_deployment/JenkinsTestServerVbc}"
      }
    }
  }
}
